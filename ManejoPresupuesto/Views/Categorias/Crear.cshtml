@model Categoria

@{
    ViewData["Title"] = "Crear categoria";
}

<h1 class="categoria-titulo">Crear categoria</h1>
<h5 class="categoria-descripcion">La categoria nos permite indicar en qué gastamos nuestro dinero,
    también, y de dónde provienen nuestros ingresos.
</h5>

<form asp-action="Crear" class="categoria-formulario">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TipoOperacionId" class="form-label"></label>
            <select asp-for="TipoOperacionId"
                    asp-items="Html.GetEnumSelectList<TipoOperacion>()"
                    class="form-select">
            </select>

    </div>

    <button type="submit" class="btn btn-primary">Enviar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>

</form>


@section Scripts{
    <partial name="_validationScriptsPartial" />
}
