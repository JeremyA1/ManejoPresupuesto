@model Categoria


@{
    ViewData["Title"] = "Borrar categoria";
}


<h3 class="mb-3">
    Esta seguro que deseea borrar la categoria @Model.Nombre?
    </h3>

<form asp-action="BorrarCategoria" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Borrar
    </button>

    <a class="btn btn-secondary" asp-action="Index">
        Cancelar
    </a>
</form>