@model ResumenMontoViewModel

<div class="contenedor-totales mb-3 transacciones-resumen">
    <div>
        <div>
            <strong>Depositos</strong>
        </div>
        <div class="activo">
            @Model.Ingresos.ToString("N")
        </div>
    </div>

    <div>
        <div>
            <strong>Retiro</strong>
        </div>
        <div class="pasivo">
            @Model.Gastos.ToString("N")
        </div>
    </div>

    <div>
        <div>
            <strong>Total</strong>
        </div>
        <div class="activo">
            @Model.Total.ToString("N")
        </div>
    </div>
</div>
