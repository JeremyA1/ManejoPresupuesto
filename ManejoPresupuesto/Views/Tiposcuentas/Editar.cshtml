@model TipoCuenta

@{
    ViewData["Title"] = "Editar Tipo Cuenta";
}

<section class="page-card form-card">
<h1 class="page-heading">Editar Tipo Cuenta: @Model.Nombre</h1>
<p class="page-description">Actualiza el nombre del tipo de cuenta.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-controller="TiposCuentas" asp-action="Editar" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-soft">Enviar</button>
    <a class="btn btn-outline-secondary btn-soft" asp-action="Index">Cancelar</a>
</form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
